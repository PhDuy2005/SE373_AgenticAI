# Cấu hình môi trường cho Agent Đặt Vé Máy Bay (BTVN#3)
# Copy file này thành .env và điền thông tin tương ứng nếu muốn sử dụng Model thật

# Nhà cung cấp và tên model
# Ví dụ OpenAI:
# SE373_MODEL="openai:gpt-4o-mini"
# OPENAI_API_KEY="sk-..."

# Ví dụ Google Gemini:
# SE373_MODEL="google-genai:gemini-1.5-flash"
# GOOGLE_API_KEY="AIzaSy..."

# Ví dụ Groq:
# SE373_MODEL="groq:llama-3.3-70b-versatile"
# GROQ_API_KEY="gsk_..."

SE373_MODEL="openai:gpt-4o-mini"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Bật cờ lỗi tệ để kiểm thử phản ứng của Agent khi quan sát thiếu thông tin:
# SE373_LOI_TE=0 (mặc định 0 - trả JSON chuẩn có gợi ý; đặt 1 - trả lỗi cộc lốc)
SE373_LOI_TE=0
